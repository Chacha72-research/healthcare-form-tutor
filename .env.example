# Copy this file to .env (in the repo root) and fill in your keys.
# Never commit .env. It is already in .gitignore.

# --- Required: reading form photos -------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Any Claude model with vision works. Change it here, not in code.
CLAUDE_MODEL=claude-sonnet-5-5

# --- Optional: spoken English conversation simulator ---------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Leave blank to use the model's default voice.
GEMINI_VOICE=

# --- Optional: text-to-speech --------------------------------------------
# "browser" uses the phone's built-in voices (free, no key needed).
# "google" uses Google Cloud Text-to-Speech, which sounds better in
# Vietnamese and Chinese on many Android phones. Needs an API key with the
# Text-to-Speech API enabled.
TTS_PROVIDER=browser
GOOGLE_TTS_API_KEY=

# --- Server ---------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=8
