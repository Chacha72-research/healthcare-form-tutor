# Copy this file to .env (in the repo root) and paste your key.
# Never commit .env. It is already in .gitignore.

# --- The only key you need (free) -----------------------------------------
# Get one at https://aistudio.google.com/apikey  (no credit card needed)
# It powers: reading pictures of forms, lesson text in the learner's
# language, the tutor's voice, and live conversation practice.
GEMINI_API_KEY=

# Without any key the app still works for PDF and text forms, in English:
# word lessons, quizzes, and the model conversations.

# --- Models (change here, not in code) --------------------------------------
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voices: https://ai.google.dev/gemini-api/docs/speech-generation
TUTOR_VOICE=Sulafat
STAFF_VOICE=Achird
LEARNER_VOICE=Puck

# --- Optional: use Claude for reading forms and writing lesson text --------
# This costs money. Voice and live practice still use Gemini.
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- Server ----------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10
